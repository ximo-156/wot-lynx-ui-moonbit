{
  "rules": [],
  "structural_rules": [
    {
      "id": "moonbit/no-unwrap",
      "severity": "warning",
      "message": "Method named unwrap() requires review; it may panic",
      "extensions": [
        ".mbt"
      ],
      "exclude": [
        "**/*_test.mbt",
        "**/*_wbtest.mbt"
      ],
      "check": {
        "moonbit_no_unwrap": true
      }
    },
    {
      "id": "moonbit/no-panic",
      "severity": "warning",
      "message": "panic() in regular code",
      "extensions": [
        ".mbt"
      ],
      "exclude": [
        "**/*_test.mbt",
        "**/*_wbtest.mbt"
      ],
      "check": {
        "moonbit_no_panic": true
      }
    },
    {
      "id": "moonbit/no-todo-comment",
      "severity": "warning",
      "message": "TODO/FIXME comment left in code",
      "extensions": [
        ".mbt"
      ],
      "exclude": [
        "**/*_test.mbt",
        "**/*_wbtest.mbt"
      ],
      "check": {
        "moonbit_no_todo": true
      }
    },
    {
      "id": "moonbit/no-println",
      "severity": "warning",
      "message": "println() left in library code",
      "extensions": [
        ".mbt"
      ],
      "exclude": [
        "**/*_test.mbt",
        "**/*_wbtest.mbt",
        "cmd/**"
      ],
      "check": {
        "moonbit_no_println": true
      }
    },
    {
      "id": "moonbit/require-public-doc",
      "severity": "error",
      "message": "Public item is missing documentation",
      "extensions": [
        ".mbt"
      ],
      "exclude": [
        "**/*_test.mbt",
        "**/*_wbtest.mbt"
      ],
      "check": {
        "moonbit_require_public_doc": true
      }
    },
    {
      "id": "moonbit/naming",
      "severity": "error",
      "message": "Name does not follow the MoonBit naming convention",
      "extensions": [
        ".mbt"
      ],
      "exclude": [
        "**/*_test.mbt",
        "**/*_wbtest.mbt"
      ],
      "check": {
        "moonbit_naming": true
      }
    }
  ]
}
