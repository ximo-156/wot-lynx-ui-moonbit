{
  "rules": [
    {
      "id": "moonbit/no-unwrap",
      "severity": "warning",
      "message": "unwrap() can panic; handle the error explicitly",
      "extensions": [".mbt"],
      "exclude": ["*_test.mbt", "*_wbtest.mbt"],
      "match": { "regex": "^[^\"]*\\.unwrap\\(\\)" }
    },
    {
      "id": "moonbit/no-panic",
      "severity": "warning",
      "message": "panic() in regular code",
      "extensions": [".mbt"],
      "exclude": ["*_test.mbt", "*_wbtest.mbt"],
      "match": { "regex": "^[^\"]*panic\\(" }
    },
    {
      "id": "moonbit/no-todo-comment",
      "severity": "warning",
      "message": "TODO/FIXME comment left in code",
      "extensions": [".mbt"],
      "exclude": ["*_test.mbt", "*_wbtest.mbt"],
      "match": { "regex": "//.*(TODO|FIXME)" },
      "match_comments": true
    },
    {
      "id": "moonbit/no-println",
      "severity": "warning",
      "message": "println() left in library code",
      "extensions": [".mbt"],
      "exclude": ["*_test.mbt", "*_wbtest.mbt"],
      "match": { "regex": "^[^\"]*println\\(" }
    }
  ],
  "structural_rules": [
    {
      "id": "moonbit/require-public-doc",
      "severity": "error",
      "message": "Public item is missing a ///| doc comment",
      "extensions": [".mbt"],
      "exclude": ["*_test.mbt", "*_wbtest.mbt"],
      "check": { "moonbit_require_public_doc": true }
    },
    {
      "id": "moonbit/naming",
      "severity": "error",
      "message": "Name does not follow the MoonBit naming convention",
      "extensions": [".mbt"],
      "exclude": ["*_test.mbt", "*_wbtest.mbt"],
      "check": { "moonbit_naming": true }
    }
  ]
}
